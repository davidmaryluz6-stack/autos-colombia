# Copiar a .env y completar valores locales. NO subir el archivo .env a GitHub.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CAMBIAR_POR_PASSWORD_MYSQL
DB_NAME=autos_colombia
SESSION_SECRET=GENERAR_CLAVE_ALEATORIA_DE_32_O_MAS_CARACTERES
NODE_ENV=development
# Para crear/actualizar cuenta de prueba en local: npm run demo:user
DEMO_USERNAME=operador
DEMO_PASSWORD=CAMBIAR_POR_PASSWORD_DE_PRUEBA
# Iteracion 3 (pagos). Todas OPCIONALES: el enunciado no define tarifas ni mora.
# PAGO_VALOR_MAXIMO=10000000   # tope de seguridad para un pago individual
# PAGO_VALOR_MENSUAL=          # valor de referencia opcional (solo sugiere/estima; no se exige)
# PAGO_MESES_CARTERA=1         # meses (hasta el actual) evaluados para cartera pendiente (1 a 24)
